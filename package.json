{
  "name": "wowf-sim",
  "version": "0.0.0",
  "private": true,
  "description": "WoW Forever DPS simulator: React UI, Go WASM engine, protobuf contract",
  "scripts": {
    "gen": "buf generate",
    "wasm": "node scripts/build-wasm.mjs",
    "cli": "go -C engine run ./cmd/cli",
    "cli:debug-rotation": "go -C engine run ./cmd/cli --debug-rotation",
    "cli:stat-weights": "go -C engine run ./cmd/cli --stat-weights",
    "catalog": "node scripts/build-catalog.mjs",
    "wowhead": "node scripts/wowhead/ingest.mjs",
    "wowhead:test": "node --test scripts/wowhead/parse.test.mjs",
    "test": "node --test scripts/wowhead/parse.test.mjs && go -C engine test ./...",
    "dev": "npm run wasm && npm --prefix web run dev",
    "build": "npm run wasm && npm --prefix web run build"
  }
}
