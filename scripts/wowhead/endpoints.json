{
  "comment": "Wowhead Forever (classicplus) hosts. npm run wowhead writes baked JSON; the browser sim never calls Wowhead. Item list pages are truncated at 1000 rows and still list Classic/SoD stubs; ingest uses the nether gear-planner dump as the Forever ID list and drops IDs whose Forever tooltip 404s. Catalog keeps uncommon+ (quality >= 2); the item picker filters rarity in the UI.",
  "name": "forever",
  "origin": "https://nether.wowhead.com",
  "www": "https://www.wowhead.com",
  "path": "forever",
  "level": 60,
  "userAgent": "wowf-sim-wowhead/0.1",
  "requestDelayMs": 50,
  "tooltipItem": "{origin}/{path}/tooltip/item/{id}?lvl={level}",
  "tooltipSpell": "{origin}/{path}/tooltip/spell/{id}",
  "spellPage": "{www}/{path}/spell={id}",
  "itemList": "{www}/{path}/{listPath}",
  "gearPlanner": "{origin}/{path}/data/gear-planner?dv=58",
  "gearPlannerItemKey": "wow.gearPlanner.classicplus.item",
  "talentsClassic": "{origin}/{path}/data/talents-classic?dv=19",
  "talentCalcPage": "{www}/{path}/talent-calc",
  "talentCalcDataKey": "wow.talentCalcClassic.classicplus.data",
  "talentBackground": "https://wow.zamimg.com/images/wow/talents/backgrounds/classic/{treeId}.jpg",
  "itemLists": [
    "items/armor",
    "items/armor/cloth",
    "items/armor/leather",
    "items/armor/mail",
    "items/armor/plate",
    "items/armor/amulets",
    "items/armor/rings",
    "items/armor/trinkets",
    "items/armor/cloaks",
    "items/armor/shields",
    "items/armor/off-hand-frills",
    "items/armor/librams",
    "items/armor/idols",
    "items/armor/totems",
    "items/weapons",
    "items/weapons/daggers",
    "items/weapons/fist-weapons",
    "items/weapons/one-handed-axes",
    "items/weapons/one-handed-maces",
    "items/weapons/one-handed-swords",
    "items/weapons/polearms",
    "items/weapons/staves",
    "items/weapons/two-handed-axes",
    "items/weapons/two-handed-maces",
    "items/weapons/two-handed-swords",
    "items/weapons/bows",
    "items/weapons/crossbows",
    "items/weapons/guns",
    "items/weapons/wands",
    "items/weapons/thrown"
  ],
  "consumableLists": [
    "items/consumables/potions"
  ],
    "enchantLists": {
    "permanent": "items/consumables/item-enhancements-permanent",
    "temporary": "items/consumables/item-enhancements-temporary"
  },
  "racialTraitList": "spells/racial-traits",
  "itemFilter": {
    "minQuality": 2,
    "keepCatalogIds": true
  }
}
